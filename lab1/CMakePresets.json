{
  "version": 5,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Lab 1 (Release, assignment)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "USE": "assignment"
      }
    },
    {
      "name": "solution",
      "displayName": "Lab 1 (Release, solution)",
      "binaryDir": "${sourceDir}/build-solution",
      "cacheVariables": {
        "USE": "solution"
      }
    },
    {
      "name": "default-tests",
      "displayName": "Lab 1 tests (assignment)",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "USE": "assignment",
        "LAB1_BUILD_UI": "OFF",
        "LAB1_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "solution-tests",
      "displayName": "Lab 1 tests (solution)",
      "binaryDir": "${sourceDir}/build-solution-tests",
      "cacheVariables": {
        "USE": "solution",
        "LAB1_BUILD_UI": "OFF",
        "LAB1_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release",
      "targets": ["lab1"]
    },
    {
      "name": "solution",
      "configurePreset": "solution",
      "configuration": "Release",
      "targets": ["lab1"]
    },
    {
      "name": "default-tests",
      "configurePreset": "default-tests",
      "configuration": "Release",
      "targets": ["lab1_tests"]
    },
    {
      "name": "solution-tests",
      "configurePreset": "solution-tests",
      "configuration": "Release",
      "targets": ["lab1_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "default-tests",
      "configurePreset": "default-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "solution-tests",
      "configurePreset": "solution-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
