{
  "version": 5,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Lab 2 (Release, assignment)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "USE": "assignment" }
    },
    {
      "name": "solution",
      "displayName": "Lab 2 (Release, solution)",
      "binaryDir": "${sourceDir}/build-solution",
      "cacheVariables": { "USE": "solution" }
    },
    {
      "name": "default-tests",
      "displayName": "Lab 2 tests (assignment)",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "USE": "assignment",
        "LAB2_BUILD_UI": "OFF",
        "LAB2_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "solution-tests",
      "displayName": "Lab 2 tests (solution)",
      "binaryDir": "${sourceDir}/build-solution-tests",
      "cacheVariables": {
        "USE": "solution",
        "LAB2_BUILD_UI": "OFF",
        "LAB2_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release", "targets": ["lab2"] },
    { "name": "solution", "configurePreset": "solution", "configuration": "Release", "targets": ["lab2"] },
    { "name": "default-tests", "configurePreset": "default-tests", "configuration": "Release", "targets": ["lab2_tests"] },
    { "name": "solution-tests", "configurePreset": "solution-tests", "configuration": "Release", "targets": ["lab2_tests"] }
  ],
  "testPresets": [
    { "name": "default-tests", "configurePreset": "default-tests", "output": { "outputOnFailure": true } },
    { "name": "solution-tests", "configurePreset": "solution-tests", "output": { "outputOnFailure": true } }
  ]
}
